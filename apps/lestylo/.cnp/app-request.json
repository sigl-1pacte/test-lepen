{
  "argocd": {
    "autoSync": true,
    "enabled": true,
    "prune": false,
    "repositoryTarget": "",
    "revision": "main",
    "selfHeal": true
  },
  "database": {},
  "description": "un stylo digne d'un voleur",
  "environments": [
    "dev",
    "staging",
    "prod"
  ],
  "features": {
    "ci": true,
    "envConfig": true,
    "logger": true,
    "yamlConfig": true
  },
  "helm": {
    "appPort": 8000,
    "config": {
      "logLevel": "INFO"
    },
    "enabled": true,
    "host": "lestylo.test-lepen.cnp.1pacte.tech",
    "ingressEnabled": true,
    "replicas": 2,
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "512Mi"
      }
    },
    "servicePort": 8000,
    "tlsEnabled": true
  },
  "kind": "service",
  "observability": {
    "backend": "loki",
    "collector": "alloy",
    "grafana": {
      "datasource": "Loki",
      "folderName": "lepen-squad-lestylo",
      "folderTitle": "lepen-squad / lestylo",
      "path": "/d/cnp-lepen-squad-lestylo-logs/lestylo-logs?orgId=1&var-team=lepen-squad&var-project=lestylo",
      "provisioning": "grafana-operator",
      "teamSubspacePath": "/teams/lepen-squad/observability/logs"
    },
    "labelSelector": "cnp.io/logging=enabled,project=lestylo,team=lepen-squad",
    "logsEnabled": true,
    "requiredPodLabels": {
      "cnp.io/logging": "enabled",
      "project": "lestylo",
      "team": "lepen-squad"
    }
  },
  "owner": "",
  "projectName": "lestylo",
  "projectSlug": "test-lepen",
  "repository": {
    "githubOrg": "sigl-1pacte",
    "private": false
  },
  "routing": {
    "reason": "No sensitive data declared; AWS EKS is the public managed cluster target.",
    "targetCluster": "aws-eks"
  },
  "security": {
    "containsSensitiveData": false,
    "dataClassification": "public",
    "publicExposure": true,
    "requiresSecrets": false
  },
  "teamName": "lepen-squad",
  "template": {
    "appType": "python-api",
    "framework": "fastapi",
    "language": "python"
  }
}
